rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 世帯IDは推測困難なランダムIDで、URLを知る二人だけがアクセスする前提。
    // 匿名認証済みユーザーのみ読み書き可。
    match /households/{householdId} {
      allow read, write: if request.auth != null;
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
